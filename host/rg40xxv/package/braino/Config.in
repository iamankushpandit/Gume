config BR2_PACKAGE_BRAINO
	bool "braino"
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_BRAINO_TFT_ESPI
	select BR2_PACKAGE_BRAINO_ARDUINOJSON
	select BR2_PACKAGE_BRAINO_MAP_N_FLAG
	help
	  Braino!, the firmware under src/ built for Linux by host/,
	  drawing straight to the panel through DRM (no GPU, no window
	  system).

	  https://github.com/iamankushpandit/Gume
