config BR2_PACKAGE_ROCKNIX_JOYPAD
	bool "rocknix-joypad"
	depends on BR2_LINUX_KERNEL
	help
	  ROCKNIX's joypad driver. On the H700 consoles it reads the
	  d-pad, buttons and both sticks (through the ADC multiplexer)
	  as one input device, "H700 Gamepad".

	  https://github.com/hackbar/rocknix-joypad
