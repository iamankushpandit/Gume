# The power and volume keys, which are not on the gamepad: busybox's acpid
# reads them and runs /etc/acpi/<action> (see /etc/acpi.map, /etc/acpid.conf).
case "$1" in
start)
    acpid -c /etc/acpi -a /etc/acpid.conf -M /etc/acpi.map -l /dev/null
    ;;
stop)
    killall acpid 2>/dev/null
    ;;
esac
exit 0
