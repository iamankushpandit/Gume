# The power and volume keys, which are not on the gamepad, and the headphone
# jack: busybox's acpid reads them and runs /etc/acpi/<action> (see
# /etc/acpi.map, /etc/acpid.conf).
case "$1" in
start)
    acpid -c /etc/acpi -a /etc/acpid.conf -M /etc/acpi.map -l /dev/null
    # acpid hears only changes, so the jack as it is at boot is set here --
    # after acpid starts, so a plug in between is not missed either way.
    # This also overrides a speaker switch alsactl restored from the last
    # shutdown, which was whatever the jack said then.
    /usr/bin/braino-headphones sync
    ;;
stop)
    killall acpid 2>/dev/null
    ;;
esac
exit 0
