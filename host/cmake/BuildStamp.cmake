# The host build's counterpart to tools/build_stamp.py: writes GumeBuildStamp.h
# with the branch, the short commit and the local build time, in the shape
# About and System Info lay out against. Run on every build, rewriting the
# file only when it would say something different, so only BuildStamp.cpp
# ever recompiles for it.
#
# Inputs: SOURCE_DIR (the repository), OUTPUT (the header to write).
#
# A worktree checked out by Windows and built from WSL has a .git FILE naming
# its git directory as "C:/...", which Linux git cannot follow. That path is
# translated to /mnt/c/... and handed to git directly, so a WSL build is
# stamped like any other. A source tarball has no .git at all and stamps
# "unknown", as tools/build_stamp.py does.

set(git_args "")
if(EXISTS "${SOURCE_DIR}/.git" AND NOT IS_DIRECTORY "${SOURCE_DIR}/.git")
  file(READ "${SOURCE_DIR}/.git" dotgit)
  if(dotgit MATCHES "gitdir: ([A-Za-z]):[/\\\\]([^\r\n]*)")
    string(TOLOWER "${CMAKE_MATCH_1}" drive)
    string(REPLACE "\\" "/" rest "${CMAKE_MATCH_2}")
    if(EXISTS "/mnt/${drive}/${rest}")
      set(git_args "--git-dir=/mnt/${drive}/${rest}" "--work-tree=${SOURCE_DIR}")
    endif()
  endif()
endif()

execute_process(COMMAND git ${git_args} rev-parse --abbrev-ref HEAD
                WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE branch_rc)
execute_process(COMMAND git ${git_args} rev-parse --short=7 HEAD
                WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE commit_rc)
if(NOT branch_rc EQUAL 0)
  set(branch "")
endif()
# CI checks out a detached HEAD; prefer the ref it was asked to build, as
# tools/build_stamp.py does.
if(NOT "$ENV{GITHUB_HEAD_REF}" STREQUAL "")
  set(branch "$ENV{GITHUB_HEAD_REF}")
elseif(NOT "$ENV{GITHUB_REF_NAME}" STREQUAL "")
  set(branch "$ENV{GITHUB_REF_NAME}")
endif()
# A build from a copied tree with no .git -- the RG40XX V image's Buildroot
# package -- is told both by its build system.
if(branch STREQUAL "" AND NOT "$ENV{BRAINO_BUILD_BRANCH}" STREQUAL "")
  set(branch "$ENV{BRAINO_BUILD_BRANCH}")
endif()
if((NOT commit_rc EQUAL 0 OR commit STREQUAL "") AND NOT "$ENV{BRAINO_BUILD_COMMIT}" STREQUAL "")
  set(commit "$ENV{BRAINO_BUILD_COMMIT}")
  set(commit_rc 0)
endif()
if(branch STREQUAL "")
  set(branch "unknown")
endif()
if(NOT commit_rc EQUAL 0 OR commit STREQUAL "")
  set(commit "unknown")
endif()

# "Sep  8 2026 22:15", the width __DATE__ " " __TIME__ produced.
string(TIMESTAMP month "%b")
string(TIMESTAMP day "%d")
string(TIMESTAMP rest "%Y %H:%M")
string(REGEX REPLACE "^0" " " day "${day}")
set(built "${month} ${day} ${rest}")

set(content "#pragma once\n/* GENERATED by host/cmake/BuildStamp.cmake on every build. */\n#define GUME_BUILD_BRANCH \"${branch}\"\n#define GUME_BUILD_COMMIT \"${commit}\"\n#define GUME_BUILD_TIME \"${built}\"\n")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
else()
  set(existing "")
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
