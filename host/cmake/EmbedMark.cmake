# Compile tools/braino-badge.svg into the host binary as a string, so the boot
# splash can draw the mark on a device that has no repository on it. Rewritten
# only when its content would change.
#
# Inputs: SVG (the artwork), OUTPUT (the header to write).

file(READ "${SVG}" svg)
set(content "#pragma once\n/* GENERATED by host/cmake/EmbedMark.cmake from tools/braino-badge.svg. */\nstatic const char BRAINO_MARK_SVG[] = R\"BRAINOSVG(${svg})BRAINOSVG\";\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
else()
  set(existing "")
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
