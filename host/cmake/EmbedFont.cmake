# Compile host/fonts/FreeSans-Latin.ttf into the host binary as a byte array,
# so the Linux build draws its text in it on a device that has no repository
# and no font directory on it (host/src/HostText.cpp). Rewritten only when its
# content would change.
#
# Inputs: FONT (the .ttf), OUTPUT (the header to write).

file(READ "${FONT}" hex HEX)
string(LENGTH "${hex}" hexLen)
math(EXPR byteCount "${hexLen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
set(content "#pragma once\n/* GENERATED by host/cmake/EmbedFont.cmake from host/fonts/FreeSans-Latin.ttf\n * (GNU FreeFont, GPL-3.0-or-later with the font exception; see\n * host/fonts/README.md). */\nstatic const unsigned char BRAINO_FONT_TTF[${byteCount}] = {\n${bytes}\n};\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
else()
  set(existing "")
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
