.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Downloaded dataset cache -- tools/gen_country_facts.py re-fetches it on demand
tools/countries_cache.json
__pycache__/
*.pyc

# Generated by tools/gen_site.py -- the Pages site is built in CI
site/_build/
# Binaries pulled from published releases by tools/fetch_release_firmware.py
site/_releases/

# tools/pack_release.py rehearsal output
dist

# Hardware identifiers stay on the machine that owns the hardware. See the
# "No identifiers in this repository" rule in CLAUDE.md -- a MAC is burned into
# eFuse and cannot be changed, so publishing one is permanent, and publishing
# it beside the firmware that board runs is worse than publishing it alone.
tools/board_registry.json
# configure_boards.py's real config: a Wi-Fi password and player names. The
# committed template is tools/bench_config.example.json.
tools/bench_config.json
